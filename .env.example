# Cloudflare hosted Images (imagedelivery.net). Hash is public and hardcoded
# in src/lib/cf-image.ts; override here only if the Images account changes.
NEXT_PUBLIC_CF_IMAGES_HASH=byE6BTe9lNqo21V57n4aPQ
NEXT_PUBLIC_CF_IMAGES_VARIANT=public

